# Environment Variables — Example
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_rms
POSTGRES_USER=smart_rms_user
POSTGRES_PASSWORD=your_secure_password_here

# ── Qdrant ──────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Google Drive ────────────────────────────────────────────────
GDRIVE_CREDENTIALS_PATH=.secrets/gdrive_service_account.json
GDRIVE_TARGET_FOLDER_ID=1o31DA1NLrK1vTFcgUMZ0Qb1y_FXBXM71

# ── JWT (Admin authentication) ──────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_32_char_random_hex
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Embedding & RAG ─────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CONFIDENCE_THRESHOLD=0.82

# ── LLM (Local Ollama — no external API required) ────────────────
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_BASE_URL=http://localhost:11434

# ── Application ─────────────────────────────────────────────────
APP_ENV=development         # development | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
